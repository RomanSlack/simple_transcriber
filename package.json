{
  "name": "simple-transcriber",
  "version": "0.1.0",
  "description": "Cross-platform meeting transcriber — record mic + system audio and get a transcript via OpenAI",
  "main": "dist/main/index.js",
  "author": {
    "name": "Roman Slack",
    "email": "romanslack@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,yellow \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.main.json && cross-env NODE_ENV=development electron . --no-sandbox",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "package": "npm run build && electron-builder",
    "package:linux": "npm run build && electron-builder --linux",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "rebuild": "electron-rebuild"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "electron-store": "^8.2.0",
    "ffmpeg-static": "^5.2.0",
    "keytar": "^7.9.0",
    "openai": "^4.77.0",
    "p-limit": "^3.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
